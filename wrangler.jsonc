{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "taff-dessert-studio",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "taff-dessert-studio"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "taff-dessert-studio-opennext-cache"
		},
		// 圖片儲存 (取代 Cloudinary)
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "taff-images"
		}
	],
	"d1_databases": [
		// 主資料庫 (取代 Google Sheets)
		{
			"binding": "DB",
			"database_name": "taff-db",
			"database_id": "2048ab77-760a-4c12-b815-b42109024227",
		},
		// OpenNext tag cache，讓 revalidateTag() 真正生效 (同一顆 D1，另開一個 binding)
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "taff-db",
			"database_id": "2048ab77-760a-4c12-b815-b42109024227",
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}